NEXT_PUBLIC_APP_NAME=Casey
NEXT_PUBLIC_BASE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Required for `npm run supabase:push` / production deploy
SUPABASE_DB_PASSWORD=
# Optional. Personal access token from https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=
# Optional. Defaults to the project ref in NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_PROJECT_ID=
# Optional. Session pooler region. Defaults to eu-west-2
# SUPABASE_DB_REGION=eu-west-2
# Optional. Full Postgres URL; overrides password/region when set
# SUPABASE_DB_URL=

RESEND_API_KEY=
RESEND_FROM=

CRON_SECRET=
CSP_ENFORCE=1

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SEAT_PRICE_ID=

# Self-hosted DocuSeal. Local: docker compose -f deploy/docuseal/docker-compose.yml up -d
# Production: Cloudflare Container worker casey-docuseal
DOCUSEAL_URL=http://localhost:3001
NEXT_PUBLIC_DOCUSEAL_URL=http://localhost:3001
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=
DOCUSEAL_SECRET_KEY_BASE=

# Cloudflare operator credentials for Wrangler deploy, token minting, and
# other account APIs. Not used by the Casey app at runtime.
# Wrangler still reads CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID; npm
# deploy/preview scripts map these admin values through automatically.
CLOUDFLARE_ADMIN_ACCOUNT_ID=
CLOUDFLARE_ADMIN_API_TOKEN=

# Casey AI runtime (Workers AI / AI Gateway). Separate from the admin token.
# Token needs Account > Workers AI > Read and AI Gateway Read/Write.
# Put CLOUDFLARE_AI_API_TOKEN on the Worker:
#   npx wrangler secret put CLOUDFLARE_AI_API_TOKEN
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# Optional. Defaults to "default" (created on first AI request).
# CLOUDFLARE_AI_GATEWAY_ID=default

# Axiom logging
AXIOM_TOKEN=
AXIOM_DATASET=
# Optional, defaults to https://api.axiom.co
# AXIOM_BASE_URL=
