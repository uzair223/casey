{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "casey-docuseal",
  "account_id": "8a14bbee799409978d0170d0bbf3e037",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "DocusealContainer",
      "image": "docker.io/docuseal/docuseal:latest",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCUSEAL",
        "class_name": "DocusealContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DocusealContainer"]
    }
  ]
}
